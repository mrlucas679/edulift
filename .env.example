# Names only. Real values live in a git-ignored .env locally and in AWS Secrets Manager
# / SSM in the deployed environment. Never commit a value here.

# --- API ---
EDULIFT_ENV=                     # local | test | demo
DATABASE_URL=                    # postgresql+psycopg://edulift:<password>@127.0.0.1:5433/edulift
AWS_REGION=                      # af-south-1 or eu-west-1 (ADR-0003)
IDENTITY_PROVIDER=               # cognito | fake (fake is refused when EDULIFT_ENV=demo)
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
CORS_ORIGINS=                    # comma-separated
TRUSTED_PROXY_HOPS=              # 0 locally, 2 behind CloudFront + load balancer

# --- App (public by design; never put a secret in an EXPO_PUBLIC_ variable) ---
EXPO_PUBLIC_API_URL=
